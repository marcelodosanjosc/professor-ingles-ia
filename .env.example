# ==============================================================================
# Desenvolvimento Local (copie para apps/api/.env) ou Produção Docker (copie para .env)
# ==============================================================================

# Banco de dados:
# - Local (SQLite): DATABASE_URL="file:./dev.db"
# - VPS / Docker (PostgreSQL existente do bairro-seguro):
#   DATABASE_URL="postgresql://postgres:SUA_SENHA_DO_POSTGRES@db:5432/fluencialab?schema=public"
DATABASE_URL="file:./dev.db"

# Caso use o docker-compose.yml apontando para o Postgres do bairro-seguro:
POSTGRES_PASSWORD="your-db-password"
POSTGRES_NETWORK="bairro-seguro-api_default"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-pelo-menos-32-caracteres"

# Provedor de IA dos professores: groq | gemini | openai | anthropic
# Deixe AI_PROVIDER e AI_API_KEY vazios para modo mock (sem custo)
AI_PROVIDER="groq"
AI_API_KEY=""
# Modelos sugeridos:
#   groq:     openai/gpt-oss-120b (grátis e ultra-rápido no console.groq.com)
#   gemini:   gemini-2.5-flash (free no aistudio.google.com)
#   openai:   gpt-4o-mini (pago com créditos pré-pagos)
#   anthropic: claude-sonnet-4-5 (pago)
AI_MODEL="openai/gpt-oss-120b"

# Legado (opcional): se AI_PROVIDER/AI_API_KEY estiverem vazios e ANTHROPIC_API_KEY
# estiver preenchida, o app usa Anthropic automaticamente.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-5"

# Porta e Origem:
# - Local: PORT=3001 e WEB_ORIGIN="http://localhost:5173"
# - VPS / Docker: PORT=8080 e WEB_ORIGIN="http://SEU_IP_OU_DOMINIO:8080"
PORT=3001
WEB_ORIGIN="http://localhost:5173"
SEED_ON_START="true"

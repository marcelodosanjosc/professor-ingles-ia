{
  "name": "fluencialab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fluencialab/api --filter @fluencialab/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test && pnpm audit --prod",
    "db:migrate": "pnpm --filter @fluencialab/api db:migrate",
    "db:seed": "pnpm --filter @fluencialab/api db:seed",
    "db:reset": "pnpm --filter @fluencialab/api db:reset"
  }
}
